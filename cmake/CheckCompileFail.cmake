foreach(required CASE_SOURCE EXPECTED INCLUDE_DIR PROBE_DIR PROBE_PROJECT CXX_COMPILER GENERATOR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing compile-fail argument: ${required}")
  endif()
endforeach()
set(configure_args -S "${PROBE_PROJECT}" -B "${PROBE_DIR}" -G "${GENERATOR}"
  "-DCASE_SOURCE=${CASE_SOURCE}" "-DINCLUDE_DIR=${INCLUDE_DIR}"
  "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}" "-DCMAKE_CXX_FLAGS=${CXX_FLAGS}")
if(PLATFORM)
  list(APPEND configure_args -A "${PLATFORM}")
endif()
if(TOOLSET)
  list(APPEND configure_args -T "${TOOLSET}")
endif()
if(TOOLCHAIN)
  list(APPEND configure_args "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" ${configure_args}
  RESULT_VARIABLE configure_result OUTPUT_VARIABLE configure_out ERROR_VARIABLE configure_err)
if(NOT configure_result EQUAL 0)
  message(FATAL_ERROR "Probe configuration failed, not an expected compile failure:\n${configure_out}${configure_err}")
endif()
if(NOT CONFIG)
  set(CONFIG Debug)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${PROBE_DIR}" --config "${CONFIG}"
  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(result EQUAL 0)
  message(FATAL_ERROR "Invalid program unexpectedly compiled: ${CASE_SOURCE}")
endif()
string(FIND "${stdout}${stderr}" "${EXPECTED}" found)
if(found EQUAL -1)
  message(FATAL_ERROR "Compilation failed for an unintended reason; expected '${EXPECTED}':\n${stdout}${stderr}")
endif()
message(STATUS "Expected diagnostic found: ${EXPECTED}")
