file(MAKE_DIRECTORY "${CASE_DIR}")
function(check_case name input status expected)
  set(path "${CASE_DIR}/${name}.csv")
  file(WRITE "${path}" "${input}")
  execute_process(COMMAND "${PROGRAM}" - INPUT_FILE "${path}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT result EQUAL status)
    message(FATAL_ERROR "${name}: exit ${result}, expected ${status}; ${stdout}${stderr}")
  endif()
  string(FIND "${stdout}${stderr}" "${expected}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "${name}: missing '${expected}' in '${stdout}${stderr}'")
  endif()
endfunction()
check_case(equal_trades "B,100,102\nT,103\nT,103\nQ\n" 0 "Q,2,2")
check_case(query_before_events "Q\n" 0 "Q,0,0")
check_case(crlf "  B,100,102\r\n T,103 \r\n Q\r\n" 0 "Q,2,2")
check_case(nan "B,100,102\nT,nan\n" 1 "line 2: expected a finite number")
check_case(infinity "B,100,102\nT,inf\n" 1 "line 2: expected a finite number")
check_case(trailing_number "B,100,102\nT,103x\n" 1 "line 2: expected a finite number")
check_case(empty_field "B,,102\n" 1 "line 1: expected a finite number")
check_case(extra_field "B,100,102,3\n" 1 "exact field count")
check_case(crossed_book "B,102,100\n" 1 "line 1: book bid exceeds ask")
check_case(trade_before_book "T,100\n" 1 "line 1: trade requires a preceding book record")
check_case(unknown_record "X,100\n" 1 "line 1: expected B,bid,ask")
message(STATUS "CSV input validation passed")
