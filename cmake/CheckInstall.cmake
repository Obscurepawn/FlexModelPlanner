if(NOT CONFIG)
  set(CONFIG Debug)
endif()
set(stage "${BUILD_DIR}/install-smoke-prefix")
set(consumer_build "${BUILD_DIR}/install-smoke-consumer")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --prefix "${stage}" --config "${CONFIG}"
  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Install failed:\n${stdout}${stderr}")
endif()
set(args -S "${SMOKE_PROJECT}" -B "${consumer_build}" -G "${GENERATOR}"
  "-DCMAKE_PREFIX_PATH=${stage}" "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}")
if(PLATFORM)
  list(APPEND args -A "${PLATFORM}")
endif()
if(TOOLSET)
  list(APPEND args -T "${TOOLSET}")
endif()
if(TOOLCHAIN)
  list(APPEND args "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" ${args}
  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Consumer configuration failed:\n${stdout}${stderr}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${consumer_build}" --config "${CONFIG}"
  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Consumer build failed:\n${stdout}${stderr}")
endif()
execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${consumer_build}" -C "${CONFIG}" --output-on-failure
  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Consumer execution failed:\n${stdout}${stderr}")
endif()
message(STATUS "Installed package configured, compiled and executed successfully")
